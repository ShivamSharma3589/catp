# ---------------------------------------------------------------- Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------------------------ PostgreSQL
POSTGRES_DB=cp_dashboard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Seconds to keep a connection open (0 = close after every request).
POSTGRES_CONN_MAX_AGE=60

# --------------------------------------------------------------- BigQuery
BIGQUERY_PROJECT=
BIGQUERY_DATASET=
BIGQUERY_LOCATION=US
# Hard ceiling per query, in bytes. Default is 2 GiB.
BIGQUERY_MAX_BYTES_BILLED=2147483648
# Path to the service-account JSON key; leave empty to use gcloud ADC.
GOOGLE_APPLICATION_CREDENTIALS=

# -------------------------------------------- Google auth (ID token flow)
# OAuth 2.0 Web client ID from Google Cloud Console. The React app uses the
# same value, and the backend checks every ID token's audience against it.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_AUTH_CLOCK_SKEW_SECONDS=10

# ------------------------------------------------------------------- JWT
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# ------------------------------------------------------------------- API
API_PAGE_SIZE=50

# -------------------------------------------------------------- Analytics
# 'local' reads the generated NDJSON in seed_data/; 'bigquery' queries BQ.
ANALYTICS_BACKEND=local
SEED_DATA_DIR=
REPORTING_DEFAULT_RANGE=last_28_days
REPORTING_MAX_RANGE_DAYS=365
REPORTING_WEEKS_IN_TREND=7

# Issues a JWT for any email without Google. DEBUG-only, for Postman.
ALLOW_DEV_TOKEN=False

# --------------------------------------------------------------- Frontend
# Origins allowed to call this API (the React dev server and prod domain).
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000
