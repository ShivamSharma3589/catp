{
  "info": {
    "name": "CAT Dealer Snapshot API",
    "description": "Backend for the CAT Dealer Snapshot dashboard. Run \"Dev token\" first; the JWT is stored automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "platform",
      "value": "google"
    },
    {
      "key": "campaignId",
      "value": ""
    },
    {
      "key": "noteId",
      "value": ""
    },
    {
      "key": "flagId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Dev token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/dev-token/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "dev-token"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"shiva@wppmedia.com\",\n  \"full_name\": \"Shivam Sharma\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.tokens) {",
                  "  pm.collectionVariables.set('accessToken', body.tokens.access);",
                  "  pm.collectionVariables.set('refreshToken', body.tokens.refresh);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Google login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/google/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "google"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credential\": \"<Google ID token from the React app>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.tokens) {",
                  "  pm.collectionVariables.set('accessToken', body.tokens.access);",
                  "  pm.collectionVariables.set('refreshToken', body.tokens.refresh);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          }
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Reporting",
      "item": [
        {
          "name": "Overview",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/overview/?range=last_28_days",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "overview"
              ],
              "query": [
                {
                  "key": "range",
                  "value": "last_28_days"
                }
              ]
            }
          }
        },
        {
          "name": "Overview - filtered",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/overview/?range=last_28_days&market=DE&platform=google,youtube",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "overview"
              ],
              "query": [
                {
                  "key": "range",
                  "value": "last_28_days"
                },
                {
                  "key": "market",
                  "value": "DE"
                },
                {
                  "key": "platform",
                  "value": "google,youtube"
                }
              ]
            }
          }
        },
        {
          "name": "Overview - custom range",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/overview/?date_from=2026-09-01&date_to=2026-09-30",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "overview"
              ],
              "query": [
                {
                  "key": "date_from",
                  "value": "2026-09-01"
                },
                {
                  "key": "date_to",
                  "value": "2026-09-30"
                }
              ]
            }
          }
        },
        {
          "name": "Filters",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/filters/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "filters"
              ]
            }
          }
        },
        {
          "name": "Campaigns (cards / table)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/campaigns/?range=last_28_days&ordering=-spend",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "campaigns"
              ],
              "query": [
                {
                  "key": "range",
                  "value": "last_28_days"
                },
                {
                  "key": "ordering",
                  "value": "-spend"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.results && body.results.length) {",
                  "  pm.collectionVariables.set('platform', body.results[0].platform);",
                  "  pm.collectionVariables.set('campaignId', body.results[0].campaign_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Campaigns - off track only",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/campaigns/?status=off_track",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "campaigns"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "off_track"
                }
              ]
            }
          }
        },
        {
          "name": "Campaigns - search",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/campaigns/?search=Search&market=UK",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "campaigns"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "Search"
                },
                {
                  "key": "market",
                  "value": "UK"
                }
              ]
            }
          }
        },
        {
          "name": "Campaigns - flagged only",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/campaigns/?flagged=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "campaigns"
              ],
              "query": [
                {
                  "key": "flagged",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "Campaign detail (modal)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/campaigns/{{platform}}/{{campaignId}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "campaigns",
                "{{platform}}",
                "{{campaignId}}"
              ]
            }
          }
        },
        {
          "name": "Export CSV",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/campaigns/export/?market=IT",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "campaigns",
                "export"
              ],
              "query": [
                {
                  "key": "market",
                  "value": "IT"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Notes",
      "item": [
        {
          "name": "List notes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/campaigns/{{platform}}/{{campaignId}}/notes/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "campaigns",
                "{{platform}}",
                "{{campaignId}}",
                "notes"
              ]
            }
          }
        },
        {
          "name": "Create note",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/campaigns/{{platform}}/{{campaignId}}/notes/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "campaigns",
                "{{platform}}",
                "{{campaignId}}",
                "notes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"Checked with the dealer team, creative refresh planned.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.id) pm.collectionVariables.set('noteId', b.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update note",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/campaigns/{{platform}}/{{campaignId}}/notes/{{noteId}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "campaigns",
                "{{platform}}",
                "{{campaignId}}",
                "notes",
                "{{noteId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"Updated note text.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete note",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/campaigns/{{platform}}/{{campaignId}}/notes/{{noteId}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "campaigns",
                "{{platform}}",
                "{{campaignId}}",
                "notes",
                "{{noteId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Flags",
      "item": [
        {
          "name": "List flags",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/campaigns/{{platform}}/{{campaignId}}/flags/?status=open",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "campaigns",
                "{{platform}}",
                "{{campaignId}}",
                "flags"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "open"
                }
              ]
            }
          }
        },
        {
          "name": "Raise flag",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/campaigns/{{platform}}/{{campaignId}}/flags/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "campaigns",
                "{{platform}}",
                "{{campaignId}}",
                "flags"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"performance\",\n  \"detail\": \"CPL spiked in week 6.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.id) pm.collectionVariables.set('flagId', b.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Resolve flag",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/campaigns/{{platform}}/{{campaignId}}/flags/{{flagId}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "campaigns",
                "{{platform}}",
                "{{campaignId}}",
                "flags",
                "{{flagId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"resolved\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Targets",
      "item": [
        {
          "name": "Get target",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/campaigns/{{platform}}/{{campaignId}}/target/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "campaigns",
                "{{platform}}",
                "{{campaignId}}",
                "target"
              ]
            }
          }
        },
        {
          "name": "Set target",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/campaigns/{{platform}}/{{campaignId}}/target/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "campaigns",
                "{{platform}}",
                "{{campaignId}}",
                "target"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kpi\": \"cpl\",\n  \"target_value\": \"55.00\",\n  \"currency\": \"EUR\",\n  \"direction\": \"lower\",\n  \"at_risk_threshold_pct\": \"10.00\",\n  \"off_track_threshold_pct\": \"25.00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}